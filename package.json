{
  "name": "persona-credit",
  "private": true,
  "version": "35.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "test:smoke": "tsx tests/golden-engine-smoke.ts",
    "test:targeted": "npm run test:smoke",
    "test:security:live": "node scripts/live-security-lifecycle-test.mjs",
    "test:release": "npm run test:smoke && npm run lint",
    "test:polish": "node scripts/release-polish-check.mjs",
    "test:provider": "node scripts/provider-acceptance-check.mjs",
    "test:slot": "node --experimental-strip-types tests/document-slot-validation.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:pb1": "npm run test:smoke && npm run test:slot && npm run test:reliability && npm run test:api-bundle && npm run typecheck:server && npm run build",
    "test:reliability": "node --experimental-strip-types tests/extraction-reliability.ts",
    "test:api-bundle": "node scripts/check-api-bundle.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.1",
    "@vercel/analytics": "^1.4.1",
    "@tailwindcss/vite": "^4.2.2",
    "@vercel/kv": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.2.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "tsx": "^4.20.3"
  }
}
